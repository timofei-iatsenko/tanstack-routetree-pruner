{
  "compilerOptions": {
    "target": "ES2023",
    "jsx": "preserve",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "noEmit": true
  },
  "include": ["./src", "./test"],
  "exclude": ["**/fixtures/"]
}
